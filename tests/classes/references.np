# objects are shared, like arrays
class Node {
    value = 0
    next = 0
}

a = Node()
b = a
b.value = 5
vana(a.value)

n1 = Node()
n2 = Node()
n1.next = n2
n1.next.value = 7
vana(n2.value)

kaam badal(n) {
    n.value = 99
}
badal(n1)
vana(n1.value)

suchi = [Node(), Node()]
suchi[0].value = 1
ko_lagi n in suchi {
    n.value = n.value + 10
}
vana(suchi)
