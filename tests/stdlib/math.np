import math
vana(math.sqrt(16))
vana(math.pow(2, 10))
vana(math.pow(2, 0.5))
vana(math.abs(-3))
vana(math.abs(-2.5))
vana(math.floor(2.7))
vana(math.ceil(2.1))
vana(math.round(2.5))
vana(math.round(3.14159, 2))
vana(math.min(3, 9))
vana(math.max(3, 9.5))
vana(math.round(math.sin(0), 3))
vana(math.cos(0))
vana(math.round(math.log(math.E), 6))
vana(math.log10(1000))
vana(math.round(math.PI, 4))
math.seed(42)
n = math.randint(1, 6)
vana(n >= 1 ra n <= 6)
r = math.random()
vana(r >= 0 ra r < 1)
