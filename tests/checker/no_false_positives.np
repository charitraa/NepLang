# Dynamic reassignment, unknown types and forward references must all be accepted.
x = 1
x = "now a string"
vana(x + "!")
y = x
vana(y)
kaam later(a) {
    farkau helper(a) + g
}
kaam helper(a) {
    farkau a * 2
}
g = 10
vana(later(4))
class Box {
    v = 0
    kaam banau(v) {
        yo.v = v
    }
    kaam show() {
        vana(yo.v)
        yo.other()
    }
    kaam other() {
        vana("other")
    }
}
b = Box(7)
b.show()
n = 0
ko_lagi i in 0..3 {
    n = n + i
}
vana(n)
