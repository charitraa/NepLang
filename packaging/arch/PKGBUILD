# Arch Linux / Manjaro / CachyOS package for NepLang, built from this checkout.
# Usage (from this folder):   makepkg -si
# Remove again:               sudo pacman -R neplang
pkgname=neplang
pkgver=1.0.0
pkgrel=1
pkgdesc="NepLang: a programming language with romanized Nepali keywords"
arch=('x86_64' 'aarch64')
url="https://github.com/charitraa/Nepa"
license=('MIT')
depends=('glibc')
optdepends=('gcc: for "neplang build" (native executables)')
makedepends=('gcc' 'make')

_src="$startdir/../.."   # the NepLang checkout this PKGBUILD lives in

build() {
    cd "$_src"
    make clean
    make
}

check() {
    cd "$_src"
    make test
}

package() {
    cd "$_src"
    make install DESTDIR="$pkgdir" PREFIX=/usr
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -d "$pkgdir/usr/share/doc/$pkgname/examples"
    install -m644 examples/*.np "$pkgdir/usr/share/doc/$pkgname/examples/"
}
